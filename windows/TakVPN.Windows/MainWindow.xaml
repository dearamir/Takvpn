<Window x:Class="TakVPN.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TakVPN" Height="720" Width="1080" MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" FlowDirection="RightToLeft" FontFamily="Segoe UI">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,18"><StackPanel><TextBlock Text="TakVPN" Foreground="White" FontSize="30" FontWeight="Bold"/><TextBlock Text="نسخه ویندوز | پیش‌نمایش اتصال Xray" Foreground="#A8AAB3"/></StackPanel><Border DockPanel.Dock="Left" Background="#292B32" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="Windows 10 / 11 • x64" Foreground="White"/></Border></DockPanel>
<Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="وضعیت اتصال" Foreground="#A8AAB3"/><TextBlock x:Name="StatusText" Text="آماده‌به‌کار" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="StatusHint" Text="برای اتصال، یک کانفیگ انتخاب کنید." Foreground="#A8AAB3" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ConnectButton" Content="اتصال VPN" Click="Connect_Click" Background="{StaticResource AccentBrush}" FontSize="15"/><Button x:Name="DisconnectButton" Content="قطع اتصال" Click="Disconnect_Click" IsEnabled="False" FontSize="15"/></StackPanel></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="کانفیگ‌های من" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="ConfigInput" Height="40" Padding="10" Background="#15161A" Foreground="White" BorderBrush="#444650" CaretBrush="White" FlowDirection="LeftToRight" VerticalContentAlignment="Center" ToolTip="لینک کانفیگ را وارد کنید"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,10"><Button Content="افزودن کانفیگ" Click="AddConfig_Click" Background="{StaticResource AccentBrush}"/><Button Content="حذف انتخاب‌شده" Click="RemoveConfig_Click"/><Button x:Name="TestButton" Content="تست این کانفیگ" Click="TestLatency_Click"/><Button x:Name="TestAllButton" Content="تست گروهی" Click="TestAll_Click"/></StackPanel></StackPanel><ListBox x:Name="ProfilesList" Background="#17181D" Foreground="White" BorderThickness="0" SelectionChanged="ProfilesList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#353741" BorderThickness="0,0,0,1" Padding="8"><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding ProtocolDisplay}" Foreground="#FF8C00" FontSize="10"/><TextBlock Text="{Binding CompactLine}" Foreground="#BFC2CB" FontSize="10" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18" Margin="8,0,0,0"><StackPanel><TextBlock Text="جزئیات کانفیگ" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="نام" Foreground="#A8AAB3"/><TextBlock x:Name="DetailName" Text="—" Foreground="White" Margin="0,4,0,16"/><TextBlock Text="پروتکل" Foreground="#A8AAB3"/><TextBlock x:Name="DetailProtocol" Text="—" Foreground="White" Margin="0,4,0,16"/><TextBlock Text="آدرس سرور" Foreground="#A8AAB3"/><TextBlock x:Name="DetailHost" Text="—" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,16" FlowDirection="LeftToRight"/><TextBlock Text="پورت" Foreground="#A8AAB3"/><TextBlock x:Name="DetailPort" Text="—" Foreground="White" Margin="0,4,0,16"/><TextBlock Text="تأخیر تونل" Foreground="#A8AAB3"/><TextBlock x:Name="DetailLatency" Text="اندازه‌گیری نشده" Foreground="#F2A04A" FontSize="18" Margin="0,4,0,16"/><TextBlock Text="اتصال از طریق Xray و رابط Wintun انجام می‌شود. برای ساخت تونل و تنظیم مسیرهای شبکه، اجرای برنامه با دسترسی مدیر لازم است." Foreground="#A8AAB3" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border>
</Grid><TextBlock Grid.Row="3" Text="TakVPN • Windows client" Foreground="#747781" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0"/></Grid></Window>